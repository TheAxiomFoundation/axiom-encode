+        b64encode(b"\x00" * 63).decode("ascii"),
+    ):
+        signature["value"] = invalid_value
+        assert (
+            _applied_encoding_manifest_signature_issue(
+                signed_payload,
+                TRUSTED_BROKER,
+            )
+            == INVALID_SIGNATURE_ISSUE
+        )

