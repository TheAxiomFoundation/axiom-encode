+        _applied_encoding_manifest_signature_issue(payload, TRUSTED_BROKER)
+        == INVALID_SIGNATURE_ISSUE
+    )
+
+
+def test_flipped_payload_byte_has_existing_invalid_issue() -> None:
+    payload = _signed_payload()
+    payload["counter"] = 1
+
