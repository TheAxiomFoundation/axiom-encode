def _applied_encoding_manifest_signature(
    payload: dict,
    signing_broker: SigningBroker,
) -> str:
    signature = signing_broker.apply_ed25519_sign(
        _unsigned_applied_encoding_manifest_bytes(payload)
    )
    if len(signature) != 64:
        raise SigningBrokerError(
            "Trusted signing broker returned an invalid apply-manifest signature"
        )
    return b64encode(signature).decode("ascii")


def _sign_applied_encoding_manifest(
    payload: dict,
    signing_broker: SigningBroker,
) -> None:
    public_key = _coerce_applied_encoding_manifest_verifier(signing_broker)
