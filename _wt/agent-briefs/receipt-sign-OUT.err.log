+    signature["value"] = None
+    assert (
+        _applied_encoding_manifest_signature_issue(signed_payload, TRUSTED_BROKER)
+        == "uses an unknown encoder apply manifest signing key"
+    )
+
+    signature["key_id"] = trusted_key_id
+    for invalid_value in (
+        None,
