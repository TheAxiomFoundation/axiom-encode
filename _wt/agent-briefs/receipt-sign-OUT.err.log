+        "domain": canonical_signing_message("apply_ed25519", b""),
+        "label": "encoder apply manifest",
+    }
+
+
+def test_envelope_issue_strings_and_ordering_are_unchanged() -> None:
+    payload: dict[str, object] = {"counter": 0}
