+    assert keyring == receipt.sign.KeyringSpec(
+        keys=(
+            receipt.sign.KeySpec(
+                key_id="apply-root",
+                fingerprint=receipt.sign.raw_public_key_sha256(raw_public_key),
+                scheme="raw-sha256",
+            ),
+        ),
+        threshold=1,
+    )
+    assert kwargs == {
+        "domain": canonical_signing_message("apply_ed25519", b""),
+        "label": "encoder apply manifest",
+    }
+
+
