+    _sign_applied_encoding_manifest(payload, TRUSTED_BROKER)
+    return payload
+
+
+def _signature(payload: dict[str, object]) -> dict[str, object]:
+    signature = payload["signature"]
+    assert isinstance(signature, dict)
+    return signature
