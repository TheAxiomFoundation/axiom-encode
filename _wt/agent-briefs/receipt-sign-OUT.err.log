+        _applied_encoding_manifest_signature_issue(payload, TRUSTED_BROKER)
+        == "has a malformed encoder apply manifest signature"
+    )
+
+    payload["signature"] = {
+        "algorithm": APPLIED_ENCODING_SIGNATURE_ALGORITHM,
+        "key_id": "unused",
+        "value": "unused",
+        "extra": "unused",
