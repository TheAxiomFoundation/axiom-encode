+    assert (
+        _applied_encoding_manifest_signature_issue(payload, TRUSTED_BROKER)
+        == "is missing an encoder apply manifest signature"
+    )
+
+    payload["signature"] = None
+    assert (
+        _applied_encoding_manifest_signature_issue(payload, TRUSTED_BROKER)
+        == "is missing an encoder apply manifest signature"
+    )
