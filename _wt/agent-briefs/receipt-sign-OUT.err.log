)
_EXPLICIT_SUBPROCESS_ENV_NAMES: Final = frozenset(
    {
        "LC_ALL",
        "PYTHONHASHSEED",
        "TZ",
    }
)
_trusted_subprocess_base_environment: dict[str, str] | None = None


def canonical_signing_message(scope: str, payload: bytes) -> bytes:
    """Bind one persisted signature to its exact operation scope."""

    if scope not in _SIGNING_SCOPES:
        raise ValueError(f"Unsupported signing scope: {scope!r}")
    if not isinstance(payload, bytes):
        raise TypeError("Signing payload must be bytes")
    return _SIGNATURE_DOMAIN_PREFIX + scope.encode("ascii") + b"\x00" + payload


class SigningBrokerError(RuntimeError):
    """The trusted signing broker is unavailable or rejected a request."""


class SigningBroker(Protocol):
    """Typed operations exposed to signing callers."""

    @property
    def capabilities(self) -> frozenset[str]: ...

    @property
    def apply_public_key_raw(self) -> bytes | None: ...

        for item in applied_files:
            if not isinstance(item, dict):
                continue
            file_path = item.get("path")
            file_hash = item.get("sha256")
            if isinstance(file_path, str) and item.get("deleted") is True:
                entries[_prefix_applied_manifest_path(file_path, root_prefix)].add(
                    APPLIED_ENCODING_DELETED_MARKER
                )
            elif isinstance(file_path, str) and isinstance(file_hash, str):
                entries[_prefix_applied_manifest_path(file_path, root_prefix)].add(
                    file_hash
                )
    return dict(entries), issues


def _prefix_applied_manifest_path(file_path: str, root_prefix: str) -> str:
    if not root_prefix:
        return file_path
    return Path(root_prefix, file_path).as_posix()


def _applied_encoding_manifest_signer() -> SigningBroker | None:
    reject_direct_private_signing_environment()
    try:
        return get_signing_broker(capability="apply_ed25519")
    except SigningBrokerError:
        return None


def _raw_ed25519_public_key(public_key: Ed25519PublicKey) -> bytes:
    """Return raw bytes without exposing private-key parsing in the CLI."""

    return public_key.public_bytes(
        encoding=serialization.Encoding.Raw,
        format=serialization.PublicFormat.Raw,
    )


def _applied_encoding_manifest_verifier() -> Ed25519PublicKey | None:
    """Load the protected broker trust root for persisted apply manifests."""

    try:
        broker = get_signing_broker()
    except SigningBrokerError:
        return None
    public_key_raw = broker.apply_public_key_raw
    if public_key_raw is None or len(public_key_raw) != 32:
        return None
    return Ed25519PublicKey.from_public_bytes(public_key_raw)


def _coerce_applied_encoding_manifest_verifier(
    verifier: SigningBroker | Ed25519PublicKey,
) -> Ed25519PublicKey:
    if isinstance(verifier, Ed25519PublicKey):
        return verifier
    public_key_raw = verifier.apply_public_key_raw
    if public_key_raw is None or len(public_key_raw) != 32:
        raise SigningBrokerError(
            "Trusted signing broker has no apply-manifest public key"
        )
    return Ed25519PublicKey.from_public_bytes(public_key_raw)


def _applied_encoding_manifest_key_id(public_key: Ed25519PublicKey) -> str:
    return f"sha256:{hashlib.sha256(_raw_ed25519_public_key(public_key)).hexdigest()}"


def _require_applied_encoding_manifest_signer() -> SigningBroker:
    signer = _applied_encoding_manifest_signer()
    if signer is None:
        raise RuntimeError(
            "Apply-manifest signing must be provisioned through an externally "
            "attached trusted signing broker initialized from the protected "
            "apply/eval/corpus-release trust-root configuration"
        )
    return signer


@contextlib.contextmanager
def _isolated_apply_manifest_signer(*, preflight: bool = False):
    """Yield the dedicated signer process; no private bytes enter this process."""

    try:
        signer = _require_applied_encoding_manifest_signer()
    except RuntimeError as exc:
        if preflight:
            raise RuntimeError(f"{exc} (preflight)") from exc
        raise
    yield signer


def _unsigned_applied_encoding_manifest_bytes(payload: dict) -> bytes:
    unsigned_payload = dict(payload)
    unsigned_payload.pop("signature", None)
    return json.dumps(
        unsigned_payload,
        sort_keys=True,
        separators=(",", ":"),
        ensure_ascii=True,
    ).encode()


def _applied_encoding_manifest_signature(
    payload: dict,
    signing_broker: SigningBroker,
) -> str:
    signature = signing_broker.apply_ed25519_sign(
        _unsigned_applied_encoding_manifest_bytes(payload)
    )
    if len(signature) != 64:
        raise SigningBrokerError(
            "Trusted signing broker returned an invalid apply-manifest signature"
        )
    return b64encode(signature).decode("ascii")


def _sign_applied_encoding_manifest(
    payload: dict,
    signing_broker: SigningBroker,
) -> None:
    public_key = _coerce_applied_encoding_manifest_verifier(signing_broker)
    payload["signature"] = {
        "algorithm": APPLIED_ENCODING_SIGNATURE_ALGORITHM,
        "key_id": _applied_encoding_manifest_key_id(public_key),
        "value": _applied_encoding_manifest_signature(payload, signing_broker),
    }


def _applied_encoding_manifest_signature_issue(
    payload: dict,
    signing_broker: SigningBroker | Ed25519PublicKey,
) -> str | None:
    signature = payload.get("signature")
    if not isinstance(signature, dict):
        return "is missing an encoder apply manifest signature"
    if set(signature) != {"algorithm", "key_id", "value"}:
        return "has a malformed encoder apply manifest signature"
    if signature.get("algorithm") != APPLIED_ENCODING_SIGNATURE_ALGORITHM:
        return "uses an unsupported encoder apply manifest signature algorithm"
    try:
        public_key = _coerce_applied_encoding_manifest_verifier(signing_broker)
    except SigningBrokerError as exc:
        return f"cannot load the encoder apply manifest trust root: {exc}"
    if signature.get("key_id") != _applied_encoding_manifest_key_id(public_key):
        return "uses an unknown encoder apply manifest signing key"
    actual = signature.get("value")
    if not isinstance(actual, str):
        return "has an invalid encoder apply manifest signature"
    try:
        raw_signature = b64decode(actual.encode("ascii"), validate=True)
    except (BinasciiError, UnicodeEncodeError):
        return "has an invalid encoder apply manifest signature"
    if len(raw_signature) != 64:
        return "has an invalid encoder apply manifest signature"
    raw_public_key = _raw_ed25519_public_key(public_key)
    receipt_key_id = "apply-root"
    signature_scope = "apply_ed25519"
    try:
        keyring = receipt.sign.KeyringSpec(
            keys=(
                receipt.sign.KeySpec(
                    key_id=receipt_key_id,
                    fingerprint=receipt.sign.raw_public_key_sha256(raw_public_key),
                    scheme="raw-sha256",
                ),
            ),
            threshold=1,
        )
        receipt.sign.verify_threshold(
            _unsigned_applied_encoding_manifest_bytes(payload),
            {receipt_key_id: raw_signature},
            {receipt_key_id: raw_public_key},
            keyring,
            domain=(
                _SIGNATURE_DOMAIN_PREFIX
                + signature_scope.encode("ascii")
                + b"\x00"
            ),
            label="encoder apply manifest",
        )
    except receipt.sign.SignError:
        return "has an invalid encoder apply manifest signature"
    return None


def _axiom_encode_repo_root() -> Path:
    return Path(__file__).resolve().parents[2]


def _git_repo_provenance(path: Path) -> dict[str, object] | None:
    """Return exact git provenance for manifest auditing."""
    repo = Path(path)
    try:
        root = subprocess.run(
            ["git", "-C", str(repo), "rev-parse", "--show-toplevel"],
            capture_output=True,
            check=True,
            text=True,
        ).stdout.strip()
            )

    if contract == "retirement" and (
        not isinstance(payload.get("reason"), str) or not payload["reason"].strip()
    ):
        issues.append(f"{manifest_label} retirement reason is invalid")

    applied_files = payload.get("applied_files")
    if isinstance(applied_files, list):
        for index, item in enumerate(applied_files):
            if isinstance(item, dict) and set(item) != expected_item_fields:
                issues.append(
                    f"{manifest_label} applied_files[{index}] does not match "
                    f"the exact {contract} file schema"
                )
    return issues


def _retired_model_manifest_issues(
    payload: Mapping[str, object],
    *,
    repo_path: Path,
    root_prefix: str,
    manifest_label: str,
    signing_broker: SigningBroker | Ed25519PublicKey,
    expected_waiver_set_sha256: str,
    local_corpus_release: LocalCorpusRelease | None,
) -> list[str]:
    """Verify the complete signed model manifest preserved by one retirement."""

    if (
        payload.get("backend") is not None
        or payload.get("tool") != APPLIED_ENCODING_RETIRE_TOOL
    ):
        return []
    retired = payload.get("retired_manifest")
    retired_label = f"{manifest_label}.retired_manifest"
    if not isinstance(retired, dict):
        return [f"{retired_label} must be a signed model apply manifest"]

    issues = _applied_manifest_exact_schema_issues(
        retired,
        manifest_label=retired_label,
    )
    signature_issue = _applied_encoding_manifest_signature_issue(
        retired, signing_broker
    )
    if signature_issue:
        issues.append(f"{retired_label} {signature_issue}")

    execution = retired.get("validation_execution")
    nested_encoder = (
        execution.get("axiom_encode") if isinstance(execution, dict) else None
    )
    expected_nested_encoder = nested_encoder if isinstance(nested_encoder, dict) else {}
    issues.extend(
        _applied_manifest_tool_execution_issues(
            retired,
            manifest_label=retired_label,
            expected_encoder_identity=expected_nested_encoder,
        )
    )
    issues.extend(
        _model_apply_validation_execution_issues(
            retired,
            manifest_label=retired_label,
            expected_waiver_set_sha256=expected_waiver_set_sha256,
            expected_encoder_identity=expected_nested_encoder,
        )
    )
    if retired.get(VALIDATION_WAIVER_SET_SHA256_FIELD) != expected_waiver_set_sha256:
        issues.append(
            f"{retired_label} {VALIDATION_WAIVER_SET_SHA256_FIELD} does not "
            "match the RuleSpec toolchain-bound waiver set"
        )

    outer_entries = payload.get("applied_files")
    nested_entries = retired.get("applied_files")
    outer_entry_list = outer_entries if isinstance(outer_entries, list) else []
    nested_entry_list = nested_entries if isinstance(nested_entries, list) else []
    outer_paths = {
        str(item.get("path"))
        for item in outer_entry_list
        if isinstance(item, dict)
        and item.get("deleted") is True
        and isinstance(item.get("path"), str)
    }
    nested_paths = {
        str(item.get("path"))
        for item in nested_entry_list
        if isinstance(item, dict)
        and isinstance(item.get("path"), str)
        and item.get("deleted") is not True
    }
    if not outer_paths or nested_paths != outer_paths:
        issues.append(
            f"{retired_label} applied files do not exactly match the retired paths"
        )
    if payload.get("source_attestation") != retired.get("source_attestation"):
        issues.append(f"{retired_label} source_attestation differs from the retirement")

    structural_retired = copy.deepcopy(retired)
    structural_retired["applied_files"] = [
        {"path": item["path"], "deleted": True}
        for item in nested_entry_list
        if isinstance(item, dict) and isinstance(item.get("path"), str)
    ]
    issues.extend(
        _applied_manifest_source_attestation_issues(
            structural_retired,
            repo_path=repo_path,
            root_prefix=root_prefix,
            manifest_label=retired_label,
        )
    )
    source_attestation = retired.get("source_attestation")
    if isinstance(source_attestation, dict):
        try:
            toolchain = load_rulespec_toolchain(repo_path)
        except ValueError as exc:
            issues.append(f"{retired_label} cannot load RuleSpec toolchain: {exc}")
        else:
            if source_attestation.get("corpus_release") != toolchain.corpus_release:
                issues.append(
                    f"{retired_label} source_attestation.corpus_release does not "
                    "match the RuleSpec toolchain release"
                )
            if (
                source_attestation.get("corpus_release_content_sha256")
                != toolchain.corpus_release_content_sha256
            ):
                issues.append(
                    f"{retired_label} source_attestation."
                    "corpus_release_content_sha256 does not match the RuleSpec "
                    "toolchain release object"
                )
        if local_corpus_release is not None:
            issues.extend(
                _signed_release_source_attestation_issues(
                    source_attestation,
                    local_corpus_release=local_corpus_release,
                    manifest_label=retired_label,
                )
            )
    return issues


def _load_verified_applied_encoding_manifest_payload(
    repo_path: Path,
    manifest_path: str,
    *,
    roots: tuple[str, ...] = tuple(sorted(RULESPEC_ATOMIC_MODULE_ROOTS)),
    signing_broker: SigningBroker | Ed25519PublicKey | None = None,
    expected_waiver_set_sha256: str | None = None,
    local_corpus_release: LocalCorpusRelease | None = None,
    expected_encoder_identity: Mapping[str, str] | None = None,
) -> tuple[dict[str, object] | None, str | None, str | None, list[str]]:
    """Load one canonical v5 apply manifest and verify every binding."""

    manifest_label = Path(manifest_path).as_posix()
    root_prefix = _applied_encoding_manifest_root_prefix(
        Path(manifest_path), roots=roots
    )
    if root_prefix is None:
        return None, None, None, []
    if signing_broker is None:
        try:
            signing_broker = _applied_encoding_manifest_verifier()
        except SigningBrokerError as exc:
            return None, root_prefix, None, [str(exc)]
    if not signing_broker:
        return (
            None,
            root_prefix,
            None,
            [
                "A protected signing broker initialized from the three-root "
                "trust config is required to verify encoder apply manifests"
            ],
        )
    if expected_waiver_set_sha256 is None:
        try:
            expected_waiver_set_sha256 = verify_rulespec_validation_waiver_set(
                repo_path
            )
        except ValueError as exc:
            return (
                None,
                root_prefix,
                None,
                [f"RuleSpec waiver-set binding is invalid: {exc}"],
            )

    relative = Path(manifest_path)
    if relative.is_absolute() or any(
        part in {"", ".", ".."} for part in relative.parts
    ):
        return (
            None,
            root_prefix,
            None,
            [f"{manifest_label} is not a safe repository path"],
        )
    repo_root = Path(repo_path).resolve()
    path = repo_root / relative
    try:
        manifest_bytes = read_bounded_regular_file(
            repo_root,
            path,
            label="encoder apply manifest",
            max_bytes=1024 * 1024,
        )
        manifest_sha256 = hashlib.sha256(manifest_bytes).hexdigest()
        payload = json.loads(manifest_bytes.decode("utf-8"))
    except UnsafeCorpusPathError as exc:
        return (
            None,
            root_prefix,
            None,
            [f"{manifest_label} cannot be read safely: {exc}"],
        )
    except (OSError, UnicodeDecodeError, json.JSONDecodeError, RecursionError):
        return None, root_prefix, None, [f"{manifest_label} is not valid JSON"]
    if not isinstance(payload, dict):
        return (
            None,
            root_prefix,
            manifest_sha256,
            [f"{manifest_label} is not a JSON object"],
        )
    if payload.get("schema_version") != APPLIED_ENCODING_MANIFEST_SCHEMA:
        return (
            None,
            root_prefix,
            manifest_sha256,
            [f"{manifest_label} is not an encoder apply manifest"],
        )
    signature_issue = _applied_encoding_manifest_signature_issue(
        payload, signing_broker
    )
    if signature_issue:
        return (
            None,
            root_prefix,
            manifest_sha256,
            [f"{manifest_label} {signature_issue}"],
        )

    issues: list[str] = []
    applied_file_snapshots: dict[str, bytes] = {}
    backend = payload.get("backend")
    issues.extend(
        _applied_manifest_exact_schema_issues(
            payload,
            manifest_label=manifest_label,
        )
    )
    if expected_encoder_identity is None:
        try:
            expected_encoder_identity = _current_guard_encoder_execution_identity()
        except RuntimeError as exc:
            issues.append(
                f"{manifest_label} cannot verify pinned encoder identity: {exc}"
            )
    if expected_encoder_identity is not None:
        issues.extend(
            applied_files=staged_applied,
            run_id=run_id,
            signing_broker=signing_broker,
            axiom_encode_git=axiom_encode_git,
            existing_manifest_path=(
                checkout_root
                / _applied_encoding_manifest_path(
                    Path(content_root.name) / relative_output
                )
            ),
            allow_shrink=allow_shrink,
        )
        manifest_relative = staged_manifest.relative_to(staged_checkout)
        return manifest_relative, staged_manifest.read_bytes()


def _require_staged_manifest_matches_validation_snapshot(
    result,
    manifest_bytes: bytes,
    *,
    output_root: Path,
    content_root: Path,
    planned: Mapping[Path, bytes],
    run_id: str | None,
    signing_broker: SigningBroker,
    axiom_encode_git: Mapping[str, object],
    local_corpus_release: LocalCorpusRelease,
) -> None:
    """Reject a manifest built from transient bytes or execution metadata."""

    snapshot = getattr(result, _APPLY_VALIDATION_SNAPSHOT_ATTR, None)
    if not isinstance(snapshot, dict):
        raise RuntimeError("Apply validation snapshot is missing")
    try:
        payload = json.loads(manifest_bytes.decode("utf-8"))
    except (UnicodeError, json.JSONDecodeError) as exc:
        raise RuntimeError("Staged apply manifest is not valid JSON") from exc
    if not isinstance(payload, dict):
        raise RuntimeError("Staged apply manifest must be a JSON object")
    signature_issue = _applied_encoding_manifest_signature_issue(
        payload,
        signing_broker,
    )
    if signature_issue:
        raise RuntimeError(f"Staged apply manifest {signature_issue}")

    result_metadata = snapshot.get("result_metadata")
    validation_execution = snapshot.get("validation_execution")
    manifest_validation_execution = snapshot.get("manifest_validation_execution")
    output = snapshot.get("output")
    trace = snapshot.get("trace")
    context = snapshot.get("context_manifest")
    if (
        not isinstance(result_metadata, dict)
        or not isinstance(validation_execution, dict)
        or not isinstance(manifest_validation_execution, dict)
        or not isinstance(output, dict)
        or not isinstance(trace, dict)
        or not isinstance(context, dict)
    ):
        raise RuntimeError("Apply validation snapshot has malformed manifest bindings")

    release_identity = (
        local_corpus_release.name,
        local_corpus_release.content_sha256,
        local_corpus_release.selector_sha256,
                "version_commit": "b" * 40,
                "identity_source": "git",
            },
        )
        payload.setdefault("generation_prompt_sha256", None)
        payload.setdefault("run_id", None)
        payload.setdefault("citation", "")
        payload.setdefault("runner", backend)
        payload.setdefault("model", "manifest-fixture")
        payload.setdefault("generated_output_root", "/tmp/axiom-generated")
        payload.setdefault("generated_output_file", None)
        payload.setdefault("generated_output_sha256", None)
        payload.setdefault("trace_file", None)
        payload.setdefault("trace_sha256", None)
        payload.setdefault("context_manifest_file", None)
        payload.setdefault("context_manifest_sha256", None)
        attestation = payload.get("source_attestation")
        rulespec_root = (
            attestation.get("rulespec_root")
            if isinstance(attestation, dict)
            else "rulespec-us/us"
        )
        encoder_git = payload.get("axiom_encode_git")
        encoder_commit = (
            encoder_git.get("commit")
            if isinstance(encoder_git, dict)
            else TEST_PINNED_ENCODER_IDENTITY["commit"]
        )
        payload.setdefault(
            "validation_execution",
            {
                "schema": "axiom-encode/apply-validation-execution/v1",
                "axiom_encode": {
                    "repository": "github.com/TheAxiomFoundation/axiom-encode",
                    "commit": encoder_commit,
                    "version": payload.get(
                        "axiom_encode_version", AXIOM_ENCODE_TEST_VERSION
                    ),
                    "identity_source": "git",
                },
                "axiom_rules_engine": {
                    "repository": ("github.com/TheAxiomFoundation/axiom-rules-engine"),
                    "commit": "e" * 40,
                },
                "policy_pre_apply": {
                    "rulespec_root": rulespec_root,
                    "pre_apply_content_sha256": "e" * 64,
                    "pre_apply_file_count": 1,
                    "toolchain_contract_sha256": "d" * 64,
                    "validation_waiver_set_sha256": payload[
                        "validation_waiver_set_sha256"
                    ],
                },
                "rulespec_dependencies": [],
            },
        )
    elif payload.get("schema_version") == APPLIED_ENCODING_MANIFEST_SCHEMA:
        applied_files = payload.get("applied_files")
        if isinstance(applied_files, list) and all(
            isinstance(item, dict) and item.get("deleted") is True
            for item in applied_files
        ):
            payload.setdefault("generated_at", "2026-07-11T00:00:00+00:00")
            payload.setdefault("tool", APPLIED_ENCODING_RETIRE_TOOL)
            payload.setdefault("reason", "test retirement")
            payload.setdefault("axiom_encode_version", AXIOM_ENCODE_TEST_VERSION)
            payload.setdefault(
                "axiom_encode_git",
                {
                    "root": "/repo/axiom-encode",
                    "commit": TEST_PINNED_ENCODER_IDENTITY["commit"],
                    "dirty_tracked": False,
                    "version": AXIOM_ENCODE_TEST_VERSION,
                    "version_commit": "b" * 40,
                    "identity_source": "git",
                },
            )
