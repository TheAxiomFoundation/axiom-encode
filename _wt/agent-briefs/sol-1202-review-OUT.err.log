    82	class SigningBroker(Protocol):
    83	    """Typed operations exposed to signing callers."""
    84	
    85	    @property
    86	    def capabilities(self) -> frozenset[str]: ...
    87	
    88	    @property
    89	    def apply_public_key_raw(self) -> bytes | None: ...
    90	
    91	    @property
    92	    def eval_public_key_raw(self) -> bytes | None: ...
    93	
    94	    @property
    95	    def corpus_release_public_key_raw(self) -> bytes | None: ...
    96	
    97	    def apply_ed25519_sign(self, payload: bytes) -> bytes: ...
    98	
    99	    def eval_ed25519_sign(self, payload: bytes) -> bytes: ...
