    43	_SIGNATURE_DOMAIN_PREFIX: Final = b"axiom-encode/external-signer-sign/v2\x00"
    44	_SIGNING_SCOPES: Final = frozenset({"apply_ed25519", "eval_ed25519"})
    45	_TRUSTED_SUBPROCESS_BASE_NAMES: Final = (
    46	    "GIT_CONFIG_GLOBAL",
