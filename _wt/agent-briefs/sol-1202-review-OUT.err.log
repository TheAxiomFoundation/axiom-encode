    68	def canonical_signing_message(scope: str, payload: bytes) -> bytes:
    69	    """Bind one persisted signature to its exact operation scope."""
    70	
    71	    if scope not in _SIGNING_SCOPES:
    72	        raise ValueError(f"Unsupported signing scope: {scope!r}")
    73	    if not isinstance(payload, bytes):
    74	        raise TypeError("Signing payload must be bytes")
    75	    return _SIGNATURE_DOMAIN_PREFIX + scope.encode("ascii") + b"\x00" + payload
